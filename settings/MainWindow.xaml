<Window
    x:Class="AhmSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="12" MaxWidth="560" HorizontalAlignment="Stretch">
            <TextBlock Text="Crosshair" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Show crosshair" />
                        <TextBlock Text="Global hotkey: Ctrl + Alt + X" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="VisibleSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""
                                  MinWidth="0" Toggled="OnChanged" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Shape" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="CrossBox" Content="Cross" Checked="OnChanged" Unchecked="OnChanged" />
                        <CheckBox x:Name="DotBox" Content="Dot" Checked="OnChanged" Unchecked="OnChanged" />
                        <CheckBox x:Name="CircleBox" Content="Circle" Checked="OnChanged" Unchecked="OnChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Header="Color" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <Expander.Content>
                    <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                 IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                 ColorChanged="OnColorChanged" />
                </Expander.Content>
            </Expander>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="12">
                    <Slider x:Name="SizeSlider" Header="Size" Minimum="2" Maximum="100" ValueChanged="OnSlider" />
                    <Slider x:Name="ThickSlider" Header="Thickness" Minimum="1" Maximum="12" ValueChanged="OnSlider" />
                    <Slider x:Name="GapSlider" Header="Gap" Minimum="0" Maximum="40" ValueChanged="OnSlider" />
                    <Slider x:Name="OpacitySlider" Header="Opacity" Minimum="5" Maximum="100" ValueChanged="OnSlider" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid>
                    <TextBlock Text="Dark outline" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="OutlineSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""
                                  MinWidth="0" Toggled="OnChanged" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid>
                    <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="StartupSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""
                                  MinWidth="0" Toggled="OnChanged" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Nudge from screen center (px)" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <NumberBox x:Name="OffXBox" Header="X" Minimum="-2000" Maximum="2000" Value="0"
                                   SpinButtonPlacementMode="Inline" ValueChanged="OnNumber" Width="140" />
                        <NumberBox x:Name="OffYBox" Header="Y" Minimum="-2000" Maximum="2000" Value="0"
                                   SpinButtonPlacementMode="Inline" ValueChanged="OnNumber" Width="140" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
