<Window
    x:Class="AhmSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="Value" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar">
            <TextBlock Text="ahm" Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Padding="20,4,20,20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- left: live preview + master switch -->
            <StackPanel Spacing="12">
                <Border CornerRadius="8" BorderThickness="1" Height="320"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1B2A22" Offset="0" />
                            <GradientStop Color="#FF4C5A52" Offset="0.55" />
                            <GradientStop Color="#FF8A8F86" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Canvas x:Name="Preview" SizeChanged="OnPreviewSize" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show crosshair" />
                            <TextBlock Text="Hotkey  Ctrl + Alt + X" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="VisibleSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""
                                      MinWidth="0" Toggled="OnChanged" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- right: controls -->
            <StackPanel Grid.Column="1" Spacing="8">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Text="Shape" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <ToggleButton x:Name="CrossBox" Content="Cross" Click="OnChanged" />
                            <ToggleButton x:Name="DotBox" Content="Dot" Click="OnChanged" />
                            <ToggleButton x:Name="CircleBox" Content="Circle" Click="OnChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock Text="Color" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                            <Button Content="Custom" Padding="10,4">
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                                     ColorChanged="OnColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Size" />
                            <TextBlock x:Name="SizeVal" Style="{StaticResource Value}" />
                        </Grid>
                        <Slider x:Name="SizeSlider" Minimum="2" Maximum="100" ValueChanged="OnSlider" />
                        <Grid>
                            <TextBlock Text="Thickness" />
                            <TextBlock x:Name="ThickVal" Style="{StaticResource Value}" />
                        </Grid>
                        <Slider x:Name="ThickSlider" Minimum="1" Maximum="12" ValueChanged="OnSlider" />
                        <Grid>
                            <TextBlock Text="Gap" />
                            <TextBlock x:Name="GapVal" Style="{StaticResource Value}" />
                        </Grid>
                        <Slider x:Name="GapSlider" Minimum="0" Maximum="40" ValueChanged="OnSlider" />
                        <Grid>
                            <TextBlock Text="Opacity" />
                            <TextBlock x:Name="OpacityVal" Style="{StaticResource Value}" />
                        </Grid>
                        <Slider x:Name="OpacitySlider" Minimum="5" Maximum="100" ValueChanged="OnSlider" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Dark outline" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="OutlineSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""
                                          MinWidth="0" Toggled="OnChanged" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="StartupSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""
                                          MinWidth="0" Toggled="OnChanged" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Offset from center" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <NumberBox x:Name="OffXBox" Header="" PlaceholderText="X" Minimum="-2000" Maximum="2000"
                                           Value="0" SpinButtonPlacementMode="Compact" ValueChanged="OnNumber" Width="110" />
                                <NumberBox x:Name="OffYBox" Header="" PlaceholderText="Y" Minimum="-2000" Maximum="2000"
                                           Value="0" SpinButtonPlacementMode="Compact" ValueChanged="OnNumber" Width="110" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="Reset to defaults" HorizontalAlignment="Right" Click="OnReset" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
